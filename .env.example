# Copy this file to .env and fill in the values.
PORT=3000
# Your Anthropic API key from https://platform.claude.com (needed for AI features)
ANTHROPIC_API_KEY=
# Claude model used for AI features. claude-haiku-5-5 is much cheaper; claude-opus-5-5 gives the best results.
AI_MODEL=claude-opus-5-5
# Where the database and uploaded files live
DATA_DIR=./data
# The site's public address, used for links in Discord messages (set automatically by deploy/setup.sh)
PUBLIC_URL=

# Optional: copy nightly backups off the server to S3-compatible storage
# (Cloudflare R2 or Backblaze B2 both have free tiers). Leave blank to keep backups on the server only.
BACKUP_S3_PROVIDER=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
